{
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node" },
    {
      "src": "frontend",
      "use": "@vercel/static-build",
      "config": { "buildCommand": "npm run build", "outputDirectory": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.js" },
    { "src": "^/(assets/.*)$", "dest": "/frontend/$1" },
    { "src": "^/favicon\\.svg$", "dest": "/frontend/favicon.svg" },
    { "src": "^/((?!.*\\.).*)$", "dest": "/frontend/index.html" }
  ]
}
